# Set these using the host's secret manager. Never commit populated values.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
AllowedHosts=staging.example.invalid;flower.example.invalid
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_AUTH_PUBLIC_API_KEY=
FIREBASE_AUTH_SERVER_API_KEY=
CRON_SECRET=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_ENV=sandbox
PUBLIC_APP_URL=https://staging.example.invalid
Reservations__WorkerEnabled=true
# Immediate reverse proxy addresses only; omit when directly exposed.
# Hosting__KnownProxies__0=10.0.0.10
# Do not set FIREBASE_AUTH_EMULATOR_HOST or FIRESTORE_EMULATOR_HOST in production.
